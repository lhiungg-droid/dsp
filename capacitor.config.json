{
  "appId": "com.dsp.console",
  "appName": "DSP Console",
  "webDir": "www",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0a0b0d",
    "webContentsDebuggingEnabled": true
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "KeepAwake": {
      "enableOnLoad": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0b0d"
    }
  }
}
